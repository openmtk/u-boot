CONFIG_ARM=y
CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ARCH_COREBOOT=y
CONFIG_SYS_COREBOOT=y
CONFIG_COREBOOT_SYSINFO=y
# CONFIG_MMC is not set
# CONFIG_MMC_PCI is not set
# CONFIG_SCSI is not set
# CONFIG_DM_SCSI is not set
# CONFIG_SCSI_AHCI is not set
# CONFIG_AHCI_PCI is not set
# CONFIG_USB is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_KEYBOARD is not set
# CONFIG_ETH_DESIGNWARE is not set
# CONFIG_RTL8169 is not set
# CONFIG_CMD_CBFS is not set
# CONFIG_FS_CBFS is not set
# CONFIG_CBMEM_CONSOLE is not set
# CONFIG_USE_PREBOOT is not set
# CONFIG_SYSINFO is not set
CONFIG_TEXT_BASE=0x80c00000
CONFIG_SYS_MALLOC_LEN=0x4000000
CONFIG_NR_DRAM_BANKS=32
CONFIG_SYS_INIT_SP_BSS_OFFSET=0x160000
CONFIG_OF_UPSTREAM=y
CONFIG_DEFAULT_DEVICE_TREE="mediatek/mt8196-rauru-navi-sku1"
CONFIG_SYS_LOAD_ADDR=0x80000000
CONFIG_REMAKE_ELF=y

# CONFIG_ARCH_FIXUP_FDT_MEMORY is not set

# pinctrl + gpio + clk
CONFIG_PINCTRL=y
CONFIG_PINCONF=y
CONFIG_PINCTRL_MT8196=y
CONFIG_CLK=y
CONFIG_CLK_MT8196=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y

# framebuffer (coreboot publishes geometry + base via sysinfo)
CONFIG_VIDEO=y
CONFIG_VIDEO_COREBOOT=y
CONFIG_VIDEO_LOGO=y
CONFIG_CONSOLE_MUX=y
CONFIG_CONSOLE_FLUSH_ON_NEWLINE=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_CMD_CLS=y

# SPI + Chrome EC keyboard
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_MTK_CHROMEOS_SPI=y
CONFIG_DM_GPIO=y
CONFIG_CROS_EC=y
CONFIG_CROS_EC_SPI=y
CONFIG_INPUT=y
CONFIG_DM_KEYBOARD=y
CONFIG_CROS_EC_KEYB=y
CONFIG_CMD_CROS_EC=y

# USB host (xhci); coreboot has powered the SSUSB PHYs already
CONFIG_USB=y
CONFIG_DM_USB=y
CONFIG_USB_HOST=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_STORAGE=y
CONFIG_CMD_USB=y
CONFIG_PARTITION_UUIDS=y
CONFIG_FS_FAT=y
CONFIG_FS_EXT4=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y

CONFIG_CMD_CBSYSINFO=y

# reset / poweroff via PSCI -> TF-A
CONFIG_ARM_PSCI_FW=y
CONFIG_SYSRESET=y
CONFIG_SYSRESET_PSCI=y
CONFIG_CMD_POWEROFF=y

CONFIG_AUTOBOOT=n
# CONFIG_USE_PREBOOT is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_DISPLAY_BOARDINFO is not set
# CONFIG_CYCLIC is not set
CONFIG_HUSH_PARSER=y

CONFIG_LOGLEVEL=7
CONFIG_LOG_MAX_LEVEL=7
CONFIG_LOG_DEFAULT_LEVEL=3

# CONFIG_CMD_BDI is not set
# CONFIG_CMD_BOOTD is not set
# CONFIG_CMD_BOOTM is not set
# CONFIG_CMD_BOOTI is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_BOOTSTD is not set
# CONFIG_DISTRO_DEFAULTS is not set

# console
CONFIG_SYS_NS16550=y
CONFIG_NS16550_SERIAL=y
# CONFIG_NS16550_DYNAMIC is not set

# early debug UART, hardcoded to mt8196 UART0
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_NS16550=y
CONFIG_DEBUG_UART_BASE=0x16000000
CONFIG_DEBUG_UART_CLOCK=26000000
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_DEBUG_UART_BAUDRATE=115200
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_SKIP_INIT=y
